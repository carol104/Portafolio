{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "{server/**,src/*.js,public/assets/yo.jpg,node_modules/pdfkit/js/data/**}"
    }
  },
  "routes": [
    {"src": "/api(?:/.*)?", "dest": "/api/index"},
    {"handle": "filesystem"},
    {"src": "/.*", "dest": "/index.html"}
  ]
}
